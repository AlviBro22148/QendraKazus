[{"id":345,"date":"2026-09-30T21:01:27","date_gmt":"2026-09-30T21:01:27","guid":{"rendered":"https:\/\/qendrakazus.com\/?p=345"},"modified":"2026-09-30T21:01:27","modified_gmt":"2026-09-30T21:01:27","slug":"heritage-voices-digital-storytelling-for-korcas-monuments","status":"publish","type":"post","link":"https:\/\/qendrakazus.com\/heritage-voices-digital-storytelling-for-korcas-monuments\/","title":{"rendered":"Heritage Voices: Digital Storytelling for Kor\u00e7a&#8217;s Monuments."},"content":{"rendered":"\n<figure class=\"wp-block-image size-large\"><img fetchpriority=\"high\" decoding=\"async\" width=\"1024\" height=\"768\" src=\"https:\/\/qendrakazus.com\/wp-content\/uploads\/2026\/09\/Bootcamp-2-1024x768.jpeg\" alt=\"\" class=\"wp-image-346\" srcset=\"https:\/\/qendrakazus.com\/wp-content\/uploads\/2026\/09\/Bootcamp-2-1024x768.jpeg 1024w, https:\/\/qendrakazus.com\/wp-content\/uploads\/2026\/09\/Bootcamp-2-300x225.jpeg 300w, https:\/\/qendrakazus.com\/wp-content\/uploads\/2026\/09\/Bootcamp-2-768x576.jpeg 768w, https:\/\/qendrakazus.com\/wp-content\/uploads\/2026\/09\/Bootcamp-2-1536x1152.jpeg 1536w, https:\/\/qendrakazus.com\/wp-content\/uploads\/2026\/09\/Bootcamp-2.jpeg 1600w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" \/><\/figure>\n\n\n\n<p class=\"wp-block-paragraph\">Zhvilluam aktivitetin e par\u00eb t\u00eb projektit <strong>HeritageVoices: Digital Storytelling for Kor\u00e7a&#8217;s Monuments<\/strong>. <\/p>\n\n\n\n<p class=\"wp-block-paragraph\">15 t\u00eb rinj m\u00ebsuan si t\u00eb p\u00ebrdorin telefonin p\u00ebr t\u00eb treguar histori, ku u njoh\u00ebn me teknikat e filmimit dhe me konceptin e storytelling-ut (MoJo). Ata diskutuan p\u00ebr monumentet e kultur\u00ebs dhe sht\u00ebpit\u00eb monument n\u00eb Kor\u00e7\u00eb, si dhe p\u00ebr ligjin e trash\u00ebgimis\u00eb kulturore dhe rolin q\u00eb kan\u00eb qytetar\u00ebt n\u00eb mbrojtjen e saj.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Hapi tjet\u00ebr: t\u00eb rinjt\u00eb do t\u00eb dalin n\u00eb terren p\u00ebr t\u00eb dokumentuar sht\u00ebpit\u00eb monument t\u00eb qytetit t\u00eb Korc\u00ebs dhe p\u00ebr t&#8217;i kthyer n\u00eb video-histori q\u00eb do t&#8217;i ndajm\u00eb me ju.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Ky aktivitet u realizua n\u00eb kuad\u00ebr t\u00eb projektit \u201c<strong>HeritageVoices: Digital Storytelling for Kor\u00e7a&#8217;s Monuments<\/strong>\u201d, i zbatuar nga Qendra KAZUS, si pjes\u00eb e skem\u00ebs s\u00eb n\u00ebngranteve t\u00eb projektit CULTUR-AL, i financuar nga Bashkimi Evropian dhe i zbatuar nga Qendra Komb\u00ebtare p\u00ebr Sh\u00ebrbime Komunitare (NCCS) n\u00eb partneritet me qendr\u00ebn Artivista.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">#HeritageVoices #Z\u00ebriIMonumenteve #Kor\u00e7a #Trash\u00ebgimiaKulturore #QendraKAZUS<\/p>\n\n\n\n<figure class=\"wp-block-gallery has-nested-images columns-default is-cropped wp-block-gallery-1 is-layout-flex wp-block-gallery-is-layout-flex\">\n<figure class=\"wp-block-image size-large\"><img decoding=\"async\" width=\"1024\" height=\"768\" data-id=\"348\" src=\"https:\/\/qendrakazus.com\/wp-content\/uploads\/2026\/09\/Bootcamp-3-1024x768.jpeg\" alt=\"\" class=\"wp-image-348\" srcset=\"https:\/\/qendrakazus.com\/wp-content\/uploads\/2026\/09\/Bootcamp-3-1024x768.jpeg 1024w, https:\/\/qendrakazus.com\/wp-content\/uploads\/2026\/09\/Bootcamp-3-300x225.jpeg 300w, https:\/\/qendrakazus.com\/wp-content\/uploads\/2026\/09\/Bootcamp-3-768x576.jpeg 768w, https:\/\/qendrakazus.com\/wp-content\/uploads\/2026\/09\/Bootcamp-3-1536x1152.jpeg 1536w, https:\/\/qendrakazus.com\/wp-content\/uploads\/2026\/09\/Bootcamp-3.jpeg 1600w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" \/><\/figure>\n\n\n\n<figure class=\"wp-block-image size-large\"><img decoding=\"async\" width=\"1024\" height=\"768\" data-id=\"349\" src=\"https:\/\/qendrakazus.com\/wp-content\/uploads\/2026\/09\/Bootcamp-4-1024x768.jpeg\" alt=\"\" class=\"wp-image-349\" srcset=\"https:\/\/qendrakazus.com\/w
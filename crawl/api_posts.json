/users\/2"}],"replies":[{"embeddable":true,"href":"https:\/\/qendrakazus.com\/wp-json\/wp\/v2\/comments?post=342"}],"version-history":[{"count":1,"href":"https:\/\/qendrakazus.com\/wp-json\/wp\/v2\/posts\/342\/revisions"}],"predecessor-version":[{"id":344,"href":"https:\/\/qendrakazus.com\/wp-json\/wp\/v2\/posts\/342\/revisions\/344"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/qendrakazus.com\/wp-json\/wp\/v2\/media\/343"}],"wp:attachment":[{"href":"https:\/\/qendrakazus.com\/wp-json\/wp\/v2\/media?parent=342"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/qendrakazus.com\/wp-json\/wp\/v2\/categories?post=342"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/qendrakazus.com\/wp-json\/wp\/v2\/tags?post=342"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":330,"date":"2026-09-02T20:11:02","date_gmt":"2026-09-02T20:11:02","guid":{"rendered":"https:\/\/qendrakazus.com\/?p=330"},"modified":"2026-09-02T20:11:02","modified_gmt":"2026-09-02T20:11:02","slug":"ecoaction-picnic","status":"publish","type":"post","link":"https:\/\/qendrakazus.com\/ecoaction-picnic\/","title":{"rendered":"EcoAction Picnic"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">EcoAction Picnic &#8211; Transformimi i t\u00eb rinjve nga zonat rurale n\u00eb advokues p\u00ebr mjedisin<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Ky projekt po zbatohet nga Qendra KAZUS n\u00eb Bashkin\u00eb e Maliqit, Shqip\u00ebri, me q\u00ebllim fuqizimin e t\u00eb rinjve p\u00ebr t&#8217;u b\u00ebr\u00eb kampion\u00eb aktiv\u00eb t\u00eb mbrojtjes s\u00eb mjedisit p\u00ebrmes angazhimit dixhital dhe pjes\u00ebmarrjes qytetare. Projekti fokusohet n\u00eb zon\u00ebn e Pojanit dhe Lozhanit dhe nxit t\u00eb rinjt\u00eb q\u00eb duke p\u00ebrdorur teknologjin\u00eb dhe rr\u00ebfimin e historive t\u00eb ngren\u00eb z\u00ebrin e tyre p\u00ebr mbrojtjen e lumit Devoll dhe t\u00eb promovojn\u00eb t\u00eb drejt\u00ebn p\u00ebr nj\u00eb mjedis t\u00eb past\u00ebr dhe t\u00eb sh\u00ebndetsh\u00ebm.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">EcoAction Picnic, is supported through the Digital Spark granting scheme, as part of the Regional Support Mechanism EECA project, implemented by Metamorphosis Foundation and TechSoup, in partnership with CIVICUS and under the Digital Democracy Initiative (DDI) that covers the Global South.<\/p>\n\n\n\n<figure class=\"wp-block-gallery has-nested-images columns-default is-cropped wp-block-gallery-3 is-layout-flex wp-block-gallery-is-layout-flex\">\n<figure class=\"wp-block-image size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"726\" height=\"1024\" data-id=\"332\" src=\"https:\/\/qendrakazus.com\/wp-content\/uploads\/2026\/09\/Eco-action-web-1-726x1024.png\" alt=\"\" class=\"wp-image-332\" srcset=\"https:\/\/qendrakazus.com\/wp-content\/uploads\/2026\/09\/Eco-action-web-1-726x1024.png 726w, https:\/\/qendrakazus.com\/wp-content\/uploads\/2026\/09\/Eco-action-web-1-213x300.png 213w, https:\/\/qendrakazus.com\/wp-content\/uploads\/2026\/09\/Eco-action-web-1-768x1082.png 768w, https:\/\/qendrakazus.com\/wp-content\/uploads\/2026\/09\/Eco-action-web-1-1090x1536.png 1090w, https:\/\/qendrakazus.com\/wp-content\/uploads\/2026\/09\/Eco-action-web-1.png 1240w\" sizes=\"(max-width: 726px) 100vw, 726px\" \/><\/figure>\n<\/figure>\n","protected":false},"excerpt":{"rendered":"<p>EcoAction Picnic &#8211; Transformimi i t\u00eb rinjve nga zonat rurale n\u00eb advokues p\u00ebr mjedisin Ky projekt po zbatohet nga Qendra [&hellip;]<\/p>\n","protected":false},"author":2,"featured_media":332,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"site-sidebar-layout":"default","site-content-layout":"","ast-site-content-layout":"default","site-content-style":"default","site-sidebar-style":"default","ast-global-header-display":"","ast-banner-title-visibility":"","ast-main-header-display":"","ast-hfb-above-header-display":"